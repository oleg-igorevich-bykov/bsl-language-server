Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ
               |	Т.Ссылка КАК Ссылка,
               |	Т.Наименование КАК Имя
               |ИЗ
               |	Справочник.Справочник1 КАК Т"; // без ошибок
Запрос.Выполнить();

Запрос2 = Новый Запрос;
Запрос2.Текст = "ВЫБРАТЬ
               |	Т.НесуществующийРеквизитQ КАК Р
               |ИЗ
               |	Справочник.Справочник1 КАК Т"; // ошибка: несуществующий реквизит
Запрос2.Выполнить();

ЗапросРегистр = Новый Запрос;
ЗапросРегистр.Текст = "ВЫБРАТЬ
               |	К.Справочник1 КАК Спр,
               |	К.Активность КАК Активность
               |ИЗ
               |	РегистрСведений.РегистрСведений1.СрезПоследних КАК К"; // без ошибок
ЗапросРегистр.Выполнить();

ЗапросРегистрОшибка = Новый Запрос;
ЗапросРегистрОшибка.Текст = "ВЫБРАТЬ
               |	К.НетТакогоПоляQ КАК Х
               |ИЗ
               |	РегистрСведений.РегистрСведений1.СрезПоследних КАК К"; // ошибка: несуществующее поле виртуальной таблицы
ЗапросРегистрОшибка.Выполнить();

ЗапросСоединение = Новый Запрос;
ЗапросСоединение.Текст = "ВЫБРАТЬ
               |	В.Ссылка КАК Ссылка,
               |	К.Активность КАК Активность
               |ИЗ
               |	Справочник.Справочник1 КАК В
               |	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрСведений1.СрезПоследних КАК К
               |	ПО В.Ссылка = К.Справочник1"; // без ошибок
ЗапросСоединение.Выполнить();

ЗапросВременнаяТаблица = Новый Запрос;
ЗапросВременнаяТаблица.Текст = "ВЫБРАТЬ
               |	Т.Ссылка КАК Ссылка
               |ПОМЕСТИТЬ ВТ
               |ИЗ
               |	Справочник.Справочник1 КАК Т
               |;
               |ВЫБРАТЬ
               |	Х.Ссылка КАК Ссылка,
               |	Х.ЧтоУгодноQ КАК Что
               |ИЗ
               |	ВТ КАК Х"; // без ошибок: поле временной таблицы не проверяется
ЗапросВременнаяТаблица.Выполнить();

ЗапросНесуществующаяТаблица = Новый Запрос;
ЗапросНесуществующаяТаблица.Текст = "ВЫБРАТЬ
               |	Т.Ссылка КАК Ссылка,
               |	Т.ЧтоУгодноQ КАК Что
               |ИЗ
               |	Справочник.ТакогоНетСправочникаQ КАК Т"; // ошибка QueryToMissingMetadata, но не по полю
ЗапросНесуществующаяТаблица.Выполнить();

ЗапросВиртуальнаяТаблица = Новый Запрос;
ЗапросВиртуальнаяТаблица.Текст = "ВЫБРАТЬ
               |	К.НетТакогоПоляQ КАК Х
               |ИЗ
               |	РегистрСведений.РегистрСведений1.НетТакойВиртуальнойQ КАК К"; // ошибка: неизвестная виртуальная таблица
ЗапросВиртуальнаяТаблица.Выполнить();

ЗапросПодзапрос = Новый Запрос;
ЗапросПодзапрос.Текст = "ВЫБРАТЬ
               |	Вн.Ссылка КАК Ссылка,
               |	Вн.ЧтоУгодноQ КАК Что
               |ИЗ
               |	(ВЫБРАТЬ
               |		Т.Ссылка КАК Ссылка
               |	ИЗ
               |		Справочник.Справочник1 КАК Т) КАК Вн"; // без ошибок: поле вложенного запроса не проверяется
ЗапросПодзапрос.Выполнить();

ЗапросОпечатка = Новый Запрос;
ЗапросОпечатка.Текст = "ВЫБРАТЬ
               |	Т.Наименован КАК Р
               |ИЗ
               |	Справочник.Справочник1 КАК Т"; // ошибка: опечатка в имени поля, есть похожее
ЗапросОпечатка.Выполнить();

// Шаблон текста запроса: "?" — плейсхолдер, заменяемый на настоящее имя (СтрЗаменить)
// до выполнения запроса, как в реальном коде БСП (УправлениеДоступомСлужебный).
// SDBL-лексер отдаёт такой символ как нераспознанный и не мешает разбору остального —
// имя, вплотную к которому он стоит, замечанием быть не должно ни по таблице, ни по полю.
ШаблонЗапроса = Новый Запрос;
ТекстШаблона =
"ВЫБРАТЬ
|	ТабличнаяЧасть?.Ссылка КАК Ссылка,
|	Т.РеквизитШаблон? КАК Р
|ИЗ
|	Документ.Документ1.ТабличнаяЧасть? КАК ТабличнаяЧасть?,
|	Справочник.Справочник1 КАК Т"; // без ошибок: и таблица, и поле — часть шаблона
ШаблонЗапроса.Текст = ТекстШаблона;
ШаблонЗапроса.Выполнить();
